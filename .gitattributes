# files that run or are read on Android must use LF
*.sh text eol=lf
*.c text eol=lf
config.txt text eol=lf
module.prop text eol=lf
module/webroot/** text eol=lf
ring_mapper binary
android-ndk-*/ export-ignore
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.aidl text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
